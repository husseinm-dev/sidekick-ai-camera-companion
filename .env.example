# Server only. Never prefix secrets with NEXT_PUBLIC_.
# Each user adds their own OpenAI API key inside the app after signing in.
OPENAI_REALTIME_MODEL=gpt-realtime
# Signs auth session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Encrypts stored user API keys at rest (32+ characters). Generate with: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=
# SQLite by default; point at a hosted database in production.
# DATABASE_URL=file:./prisma/dev.db
# Optional explicit public origin, useful behind an HTTPS proxy (no trailing slash).
# APP_ORIGIN=https://your-app.example
